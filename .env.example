# HRES Configuration
# This file is used to configure the HRES application backend.

# Database URL
# For local SQLite development (default):
# DATABASE_URL=sqlite:///./data/hres.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./data/hres.db

# API Keys
FORTYGUARD_API_KEY=your_fortyguard_key_here
GEMINI_API_KEY=your_gemini_key_here
KIRO_API_KEY=your_kiro_key_here
GROQ_API_KEY=your_groq_key_here
RESEND_API_KEY=your_resend_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Google OAuth 2.0 Client ID for Login
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT Secret for securing API sessions
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# Email Service Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
