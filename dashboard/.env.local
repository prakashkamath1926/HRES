# Frontend environment variables for HRES Dashboard
# ─── Google OAuth ────────────────────────────────────────────
# Paste your Google Client ID here (must match the one in backend .env)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=739276529322-shfm0n5qhl61d0n5ugf23lo3l5nstg0r.apps.googleusercontent.com

# ─── API Base URL ────────────────────────────────────────────
# Leave empty to use Vite's proxy (development default)
# Set to your deployed backend URL in production (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=
